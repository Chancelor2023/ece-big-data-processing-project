# Copy to .env before starting. Keep .env out of Git.
COMPOSE_PROJECT_NAME=imdb-big-data
JUPYTER_PORT=8888
SPARK_UI_PORT=4040
KAFKA_PORT=9092
# Replace locally with a token of your choice; localhost access only.
JUPYTER_TOKEN=change-this-local-token

# Python, Spark and Java run inside the container, not on the host.
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=4
